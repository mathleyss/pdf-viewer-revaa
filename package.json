{
  "name": "revaa-pdf-viewer",
  "version": "1.1.0",
  "description": "Visionneuse PDF protégée avec bloc Gutenberg",
  "private": true,
  "scripts": {
    "postinstall":   "node scripts/install-pdfjs.js",
    "install-pdfjs": "node scripts/install-pdfjs.js",
    "build":         "wp-scripts build blocks/pdf-viewer/index.js --output-path=build",
    "start":         "wp-scripts start blocks/pdf-viewer/index.js --output-path=build"
  },
  "devDependencies": {
    "@wordpress/scripts": "^30.0.0",
    "copy-webpack-plugin": "^12.0.0"
  }
}
