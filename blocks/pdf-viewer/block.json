{
  "name": "revaa/pdf-viewer",
  "title": "PDF Protégé",
  "description": "Affiche un bouton d'accès à un PDF sécurisé.",
  "category": "media",
  "icon": "media-document",
  "supports": { "html": false },
  "attributes": {
    "fileSlug": { "type": "string", "default": "" },
    "fileName": { "type": "string", "default": "" },
    "label":    { "type": "string", "default": "" }
  },
  "editorScript": "file:./index.js",
  "editorStyle":  "file:./editor.css",
  "style":        "file:./style.css"
}
