{
  "name": "revaa/pdf-viewer",
  "title": "Document REVAA",
  "description": "Bloc pour inclure un document PDF dans une page ou un article, protégé contre les téléchargements.",
  "category": "media",
  "icon": "media-document",
  "supports": { "html": false },
  "attributes": {
    "fileSlug": { "type": "string", "default": "" },
    "fileName": { "type": "string", "default": "" },
    "label": { "type": "string", "default": "" }
  },
  "editorScript": "file:./index.js",
  "editorStyle": "file:./editor.css",
  "style": "file:./style.css"
}
